{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Covers both src/ and test/. TypeScript 6 requires this to be explicit
    // when a tool (ts-jest) compiles a file outside the common source root.
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "jest"],

    "composite": false,
    "declaration": false,
    "declarationMap": false,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,

    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
