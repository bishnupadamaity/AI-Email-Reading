{
  "name": "email-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted analysis of business emails and their attachments.",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./frontend\" --filter \"./backend\" dev",
    "dev:web": "pnpm --filter \"./frontend\" dev",
    "dev:api": "pnpm build:packages && pnpm --filter \"./backend\" dev",
    "dev:ai": "cd ai-service && .venv/bin/python -m ai_service.main",
    "typecheck": "pnpm -r typecheck",
    "typecheck:ai": "cd ai-service && .venv/bin/mypy",
    "lint": "eslint .",
    "lint:ai": "cd ai-service && .venv/bin/ruff check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:ai": "cd ai-service && .venv/bin/ruff format .",
    "test": "pnpm -r test",
    "test:integration": "pnpm build:packages && pnpm --filter \"./backend\" test:integration",
    "test:ai": "cd ai-service && .venv/bin/python -m pytest",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
