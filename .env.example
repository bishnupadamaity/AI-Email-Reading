# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Never commit a real `.env`.
# Nothing in this file is required to start the web app, the API, or local
# infrastructure — the AI/email provider values are only needed once those
# features are implemented.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
# NODE_ENV is deliberately NOT set here. Vite reads this file too, and a
# NODE_ENV of "development" in it makes `pnpm build` emit development React
# bundles. Let the process environment or the deployment set it; the API
# schema defaults it to "development".
LOG_LEVEL=debug

# --- API (backend) ---------------------------------------------------------
API_PORT=3000
API_GLOBAL_PREFIX=api
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Serve Swagger UI at ${API_GLOBAL_PREFIX}/docs. Disable in production.
SWAGGER_ENABLED=true

# --- PostgreSQL ----------------------------------------------------------
# Set to false to boot the API without a database (useful for UI-only work).
DATABASE_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=email_ai
POSTGRES_PASSWORD=email_ai_local_password
POSTGRES_DB=email_ai
# Schema is managed by explicit migrations only; never auto-synchronised.
DATABASE_LOGGING=false

# --- AI service (ai-service) ------------------------------------------------
# All AI work happens in the Python service. The API calls it over an internal
# HTTP contract and holds no provider credential, no model name and no prompt.
#
# `false` (the default) keeps the whole stack runnable with no AI at all: the
# API boots, every other endpoint works, and POST /emails/:id/analyze responds
# 503 with an explicit configuration error.
AI_SERVICE_ENABLED=false
# Where the API finds the AI service. Internal only; never reachable from the
# browser.
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared bearer token between the API and the AI service. Optional for
# loopback development; the AI service REFUSES TO START without one when it
# binds to a non-loopback address.
AI_SERVICE_TOKEN=
# Deadline for the AI service to answer, in milliseconds. Deliberately above
# LLM_TIMEOUT_MS below, so a slow provider is recorded as a provider timeout
# (with its model accounting) rather than as a transport failure.
AI_SERVICE_REQUEST_TIMEOUT_MS=90000
# Deadline for establishing the connection, as opposed to answering it.
AI_SERVICE_CONNECT_TIMEOUT_MS=2000

# Where the AI service itself listens. Loopback by default.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# --- LLM provider (read by ai-service only) -------------------------
# `none` (the default) keeps the AI service runnable without credentials: it
# starts, health checks pass, and an AI request fails with an explicit
# configuration error rather than a fabricated result. Set to `openai` to
# enable AI operations.
LLM_PROVIDER=none
# Your OpenAI API key. LLM_API_KEY is accepted as a fallback.
# Never commit a real key. The API and the browser never see this value.
OPENAI_API_KEY=
LLM_API_KEY=
# Per-request deadline for the model call, in milliseconds.
LLM_TIMEOUT_MS=60000
# Output token ceiling per model call.
LLM_MAX_OUTPUT_TOKENS=16000
# Retries the SDK performs on 429/5xx/connection errors.
LLM_MAX_RETRIES=2
# Prompt size ceiling. Oversized emails are rejected, never truncated.
LLM_MAX_INPUT_CHARS=200000

# --- Analysis lifecycle (backend) ---------------------------------------
# How long an analysis may sit in `processing` before another request may
# reclaim it. Covers a crashed process, not a slow provider. Keeps its
# historical name so existing deployments' .env files stay valid.
LLM_STALE_PROCESSING_MS=300000

# --- Model per AI operation (read by ai-service only) ---------------
# Each operation routes to its own model. Leave a variable empty to use the
# default shown in the comment; any value here overrides that default for that
# operation only. The defaults live in `ModelRegistry`
# (ai-service/ai_service/registry.py) so there is one source of truth.
#
# Defaults were chosen from OpenAI's published per-1M-token prices read on
# 2026-10-15 (gpt-6-luna $0.10/$0.50, gpt-6-sol $2.00/$10.00,
# gpt-6-astra $10.00/$50.00) and re-verified at the Python migration: all three
# ids exist, are served by the Responses API and support Structured Outputs.
# Prices change — check them before relying on these choices, and override
# freely.
#
# A short label from text already in front of the model.          [gpt-6-luna]
OPENAI_MODEL_CLASSIFICATION=
# Strict structured output across 16 fields with evidence spans.   [gpt-6-sol]
OPENAI_MODEL_EXTRACTION=
# Short prose from text already in front of the model.            [gpt-6-luna]
OPENAI_MODEL_SUMMARIZATION=
# Weighing contradictory statements; the hardest job here.       [gpt-6-astra]
OPENAI_MODEL_CONFLICT_RESOLUTION=

# Only `extraction` has a caller today. The other three are configurable and
# validated at the AI service's startup so a typo fails loudly, but nothing
# invokes them yet. `GET /health/ready` on the AI service reports both the
# routing table and which operations are implemented.
# There is deliberately no automatic fallback model: if a configured model is
# unavailable or cannot do Structured Outputs, the request fails with a
# configuration error naming the model rather than silently using another.

# --- Web (frontend) ------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_API_BASE_URL=http://localhost:3000/api
